{
  "info": {
    "name": "Restaurant Leftover Food API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "foodId", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Restaurant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Green Spoon Restaurant\",\n  \"email\": \"restaurant1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"restaurant\",\n  \"phone\": \"01700000000\",\n  \"address\": \"Gulshan, Dhaka\",\n  \"organizationName\": \"Green Spoon\"\n}"
            }
          }
        },
        {
          "name": "Register Receiver/NGO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hope Foundation\",\n  \"email\": \"receiver1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"receiver\",\n  \"phone\": \"01800000000\",\n  \"address\": \"Mirpur, Dhaka\",\n  \"organizationName\": \"Hope Foundation NGO\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"restaurant1@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/users"
          }
        }
      ]
    },
    {
      "name": "Food",
      "item": [
        {
          "name": "Create Food Listing (Restaurant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/food",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodName\": \"Rice & Curry\",\n  \"description\": \"Freshly cooked, unsold surplus\",\n  \"quantity\": 20,\n  \"unit\": \"plates\",\n  \"foodType\": \"mixed\",\n  \"pickupAddress\": \"Gulshan 1, Dhaka\",\n  \"expiryTime\": \"2026-07-28T20:00:00.000Z\"\n}"
            }
          }
        },
        {
          "name": "Get All Food (Available)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/food?status=available"
          }
        },
        {
          "name": "Get My Listings (Restaurant)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/food?mine=true"
          }
        },
        {
          "name": "Get Food By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/food/{{foodId}}"
          }
        },
        {
          "name": "Update Food",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/food/{{foodId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 15\n}"
            }
          }
        },
        {
          "name": "Delete Food",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/food/{{foodId}}"
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create Request (Receiver)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodId\": \"{{foodId}}\",\n  \"message\": \"We can pick up within an hour\"\n}"
            }
          }
        },
        {
          "name": "Get My Requests (Receiver)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/requests/my"
          }
        },
        {
          "name": "Get Received Requests (Restaurant)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/requests/received"
          }
        },
        {
          "name": "Update Request Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            }
          }
        },
        {
          "name": "Get All Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/requests"
          }
        }
      ]
    }
  ]
}
