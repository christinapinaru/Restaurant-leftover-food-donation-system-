{
  "info": {
    "_postman_id": "food-donation-app-api",
    "name": "Food Donation App API",
    "description": "Complete API collection for Food Donation App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check server and MongoDB connection status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            },
            "description": "Register a new user account"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login with user credentials"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Food Items",
      "item": [
        {
          "name": "Get All Available Food",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/all",
              "host": ["{{base_url}}"],
              "path": ["all"]
            },
            "description": "Fetch all available food items"
          },
          "response": []
        },
        {
          "name": "Add Food Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"food\": \"Rice\",\n  \"qty\": \"10 plates\",\n  \"location\": \"Downtown\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/add",
              "host": ["{{base_url}}"],
              "path": ["add"]
            },
            "description": "Add a new food item for donation"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Get All Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/requests",
              "host": ["{{base_url}}"],
              "path": ["requests"]
            },
            "description": "Fetch all pending food requests"
          },
          "response": []
        },
        {
          "name": "Create Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"food\": \"Rice\",\n  \"qty\": \"10 plates\",\n  \"user\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/request",
              "host": ["{{base_url}}"],
              "path": ["request"]
            },
            "description": "Create a new food request"
          },
          "response": []
        },
        {
          "name": "Confirm Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<request_id>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["confirm"]
            },
            "description": "Confirm a pending food request"
          },
          "response": []
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "Get Donation History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/history",
              "host": ["{{base_url}}"],
              "path": ["history"]
            },
            "description": "Fetch completed donation history"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
